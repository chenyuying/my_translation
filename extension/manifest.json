{
  "manifest_version": 3,
  "name": "cc-translate",
  "version": "0.1.0",
  "description": "本地沈浸式翻譯：呼叫本機 claude 翻譯網頁並可存進 Obsidian",
  "browser_specific_settings": {
    "gecko": { "id": "cc-translate@local", "strict_min_version": "128.0" }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "scripts": ["src/background.js"] },
  "action": { "default_popup": "src/popup.html", "default_title": "cc-translate" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/extract.js", "src/inject.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
